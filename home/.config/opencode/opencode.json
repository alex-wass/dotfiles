{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "enabled": true,
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--browser-url=http://127.0.0.1:9222"]
    },
    "paper": {
      "type": "remote",
      "url": "http://127.0.0.1:29979/mcp",
      "enabled": true
    },
    "tablepro": {
      "type": "local",
      "command": ["/Applications/TablePro.app/Contents/MacOS/tablepro-mcp"]
    }
  },
  "plugin": ["opencode-with-claude"],
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:3456",
        "apiKey": "dummy"
      }
    }
  },
  "permission": {
    "bash": {
      "rm *": "ask",
      "git push *": "deny",
      "git reset *": "deny"
    },
    "external_directory": {
      "/tmp/**": "allow"
    }
  }
}
